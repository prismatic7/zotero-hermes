{
  "name": "zotero-hermes",
  "type": "module",
  "version": "0.4.0",
  "description": "Hermes AI Agent integration for Zotero — Chat with your research library",
  "config": {
    "addonName": "Hermes Agent for Zotero",
    "addonID": "hermes@techne-tools.org",
    "addonRef": "hermes",
    "addonInstance": "HermesAgent",
    "prefsPrefix": "extensions.zotero.hermes"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/techne-tools/zotero-hermes.git"
  },
  "author": "techne-tools",
  "bugs": {
    "url": "https://github.com/techne-tools/zotero-hermes/issues"
  },
  "homepage": "https://github.com/techne-tools/zotero-hermes#readme",
  "license": "MIT",
  "scripts": {
    "start": "zotero-plugin serve",
    "serve": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint": "npm run lint:check",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^18.3.1",
    "zotero-plugin-toolkit": "^5.2.0"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.7",
    "@zotero-plugin/eslint-config": "^0.6.7",
    "chai": "^6.2.1",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.9.2",
    "zotero-types": "^4.1.3"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
